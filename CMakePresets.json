{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-clang-debug",
      "displayName": "Windows Debug (Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-windows-clang-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_ASM_NASM_COMPILER": "C:/Program Files/NASM/nasm.exe",
        "SNAKE_PLATFORM": "AUTO",
        "SNAKE_USE_VENDORED_TTF_DEPS": "ON"
      }
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows Release (Clang)",
      "inherits": "windows-clang-debug",
      "binaryDir": "${sourceDir}/cmake-build-windows-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-sdl-debug",
      "displayName": "Windows SDL Debug (Clang)",
      "inherits": "windows-clang-debug",
      "binaryDir": "${sourceDir}/cmake-build-windows-sdl-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SNAKE_PLATFORM": "SDL"
      }
    },
    {
      "name": "windows-sdl-release",
      "displayName": "Windows SDL Release (Clang)",
      "inherits": "windows-clang-debug",
      "binaryDir": "${sourceDir}/cmake-build-windows-sdl-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SNAKE_PLATFORM": "SDL"
      }
    },
    {
      "name": "windows-win32-debug",
      "displayName": "Windows Win32 Debug (Clang)",
      "inherits": "windows-clang-debug",
      "binaryDir": "${sourceDir}/cmake-build-windows-win32-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SNAKE_PLATFORM": "WINDOWS"
      }
    },
    {
      "name": "windows-win32-release",
      "displayName": "Windows Win32 Release (Clang)",
      "inherits": "windows-clang-debug",
      "binaryDir": "${sourceDir}/cmake-build-windows-win32-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SNAKE_PLATFORM": "WINDOWS"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-macos-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "SNAKE_PLATFORM": "SDL",
        "SNAKE_USE_VENDORED_TTF_DEPS": "ON"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "macos-debug",
      "binaryDir": "${sourceDir}/cmake-build-macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-linux-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SNAKE_PLATFORM": "SDL",
        "SNAKE_USE_VENDORED_TTF_DEPS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/cmake-build-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug"
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release"
    },
    {
      "name": "windows-sdl-debug",
      "configurePreset": "windows-sdl-debug",
      "targets": [
        "SnakeGameSDL"
      ]
    },
    {
      "name": "windows-sdl-release",
      "configurePreset": "windows-sdl-release",
      "targets": [
        "SnakeGameSDL"
      ]
    },
    {
      "name": "windows-win32-debug",
      "configurePreset": "windows-win32-debug",
      "targets": [
        "SnakeGameWin32"
      ]
    },
    {
      "name": "windows-win32-release",
      "configurePreset": "windows-win32-release",
      "targets": [
        "SnakeGameWin32"
      ]
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "targets": [
        "publish"
      ]
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "targets": [
        "publish"
      ]
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ]
}
